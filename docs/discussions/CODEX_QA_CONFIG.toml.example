# Copy this file to C:\Users\Anand\Desktop\recall-app\.codex\config.toml
# only after removing legacy `sandbox_mode` / `[sandbox_workspace_write]`
# settings from every loaded Codex configuration.

project_doc_fallback_filenames = ["CHATGPT_QA.md"]
default_permissions = "revisop-qa"
approval_policy = "never"

[permissions.revisop-qa]
description = "RevisOp QA: repository read-only, discussion records writable."

[permissions.revisop-qa.filesystem]
":root" = "read"
glob_scan_max_depth = 5

# Sensitive locations outside the repo (":root" read is broad; these stay denied)
"~/.codex/auth.json" = "deny"
"~/.codex/.sandbox-secrets" = "deny"
"~/.claude" = "deny"
"~/.ssh" = "deny"
"~/.aws" = "deny"
"~/.config/gh" = "deny"
"~/.git-credentials" = "deny"
"~/AppData/Local/Google/Chrome/User Data" = "deny"
"~/AppData/Local/Microsoft/Edge/User Data" = "deny"

[permissions.revisop-qa.filesystem.":workspace_roots"]
"." = "read"
"docs/discussions" = "write"
"docs/active/design-review/_storage-state*.json" = "deny"
".env" = "deny"
".env.*" = "deny"
"**/.env" = "deny"
"**/.env.*" = "deny"

[permissions.revisop-qa.network]
enabled = false
